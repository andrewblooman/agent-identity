# Which data the dashboard opens with: demo or live
DEFAULT_VIEW=demo

# AWS profile from ~/.aws to scan with. Use a profile limited to iam/scanner-readonly-policy.json.
AWS_PROFILE=default

# Regions to scan, comma separated
SCAN_REGIONS=eu-west-1

# How far back to look in CloudTrail for model calls
CLOUDTRAIL_LOOKBACK_DAYS=14

# Pull and scan ECR images with Trivy when Inspector has no results (true or false)
TRIVY_ENABLED=true
